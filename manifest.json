{
  "manifestVersion": 6,
  "id": "com.fayelab.opencurve",
  "name": "OpenCurve 2",
  "version": "2.1.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.1.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "opencurve-panel",
      "label": { "default": "OpenCurve 2" },
      "minimumSize":           { "width": 380, "height": 440 },
      "maximumSize":           { "width": 2400, "height": 1600 },
      "preferredDockedSize":   { "width": 900, "height": 620 },
      "preferredFloatingSize": { "width": 900, "height": 660 }
    }
  ],
  "requiredPermissions": {
    "clipboard": "readAndWrite",
    "network": {
      "domains": ["api.github.com"],
      "reasonForPermission": "Check GitHub for new OpenCurve releases"
    },
    "localFileSystem": "request",
    "launchProcess": {
      "schemes": ["https"],
      "extensions": []
    }
  },
  "icons": [
    {
      "width": 23, "height": 23,
      "path": "icons/icon-dark.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium"]
    },
    {
      "width": 48, "height": 48,
      "path": "icons/plugin-icon-dark.png",
      "scale": [1, 2],
      "species": ["pluginList"],
      "theme": ["darkest", "dark", "medium"]
    }
  ]
}
